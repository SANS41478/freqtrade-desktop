# Freqtrade Desktop - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Freqtrade API connection
VITE_FT_API_HOST=127.0.0.1
VITE_FT_API_PORT=8080

# Freqtrade API authentication (Basic Auth)
# Set these to match your Freqtrade config's api_server.username / password
VITE_FT_API_USER=freqtrader
VITE_FT_API_PASS=

# Freqtrade WebSocket token
# Set this to match your Freqtrade config's api_server.ws_token
VITE_FT_WS_TOKEN=